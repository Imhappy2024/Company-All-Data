# LeavenWealth "Company-All-Data" — environment variable TEMPLATE (names only, no real values).
# Copy to .env and fill in locally / set in Railway. NEVER put real secrets in this file.
# Never send SUPABASE_SERVICE_ROLE to the browser.

# ---------- Ops dashboard (ClickUp + Supabase) — already in use ----------
# Postgres connection string for the Supabase DB (server-side only):
#   postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Set to "supabase" to make Properties/loans/tasks read from Supabase (vs ClickUp-only).
DATA_SOURCE=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=
# Comma-separated emails/usernames/ids allowed to sign in via ClickUp OAuth.
CLICKUP_ALLOWED_USERS=
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
# Railway injects PORT in prod; set locally only if you want a non-3000 port.
PORT=

# ---------- Portal live-data + auth (to be added in Task 1) ----------
# Public project URL (safe in the browser): https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable/anon key (safe in the browser; RLS enforces access).
SUPABASE_ANON_KEY=
# Service role key — SERVER-SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE=
