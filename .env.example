# LeavenWealth "Company-All-Data" — environment variable TEMPLATE (names only, no real values).
# Copy to .env and fill in locally / set in Railway. NEVER put real secrets in this file.
# Never send SUPABASE_SERVICE_ROLE to the browser.

# ---------- Ops dashboard (ClickUp + Supabase) — already in use ----------
# Postgres connection string for the Supabase DB (server-side only):
#   postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Set to "supabase" to make Properties/loans/tasks read from Supabase (vs ClickUp-only).
DATA_SOURCE=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
# Exact redirect URL registered on the ClickUp OAuth app; leave empty to derive it from proxy headers
CLICKUP_OAUTH_REDIRECT_URI=
# Railway injects PORT in prod; set locally only if you want a non-3000 port.
PORT=

# ---------- Portal live-data + auth ----------
# These two are served to the browser by GET /api/portal-config, which returns 503
# naming whichever is missing rather than serving undefined. So the portal's
# Supabase features fail closed and legibly while these are unset.
# Public project URL (safe in the browser): https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable/anon key (safe in the browser; RLS enforces access).
SUPABASE_ANON_KEY=
# Service role key — SERVER-SIDE ONLY. Never expose to the browser, never read it
# into any code path that responds to a browser request. The Phase 11 invite route
# returns 503 without it rather than falling back to the anon key.
SUPABASE_SERVICE_ROLE=

# ---------- Live sync (Supabase webhooks -> Server-Sent Events) ----------
# Shared secret between the Postgres trigger and POST /api/hooks/supabase.
# Generate with: openssl rand -hex 32
# The endpoint returns 503 while this is unset - it fails closed on purpose.
SUPABASE_WEBHOOK_SECRET=
# Optional tuning; the defaults in realtime.js are fine.
SSE_PING_MS=
SSE_COALESCE_MS=
SSE_MAX_CLIENTS=
SSE_MAX_PER_IP=
