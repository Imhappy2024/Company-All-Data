# Secrets — never commit real env values
.env
.env.*
!.env.example
# Stray Windows-friendly copies that may hold real values
env.example.txt
gitignore.txt
*.secret.txt

# Node
node_modules/
npm-debug.log*
yarn-error.log*
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python (migration script)
__pycache__/
*.pyc

# dev-only harness (fixtures + screenshots), never deployed
dev/
